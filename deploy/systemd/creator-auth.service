[Unit]
Description=creator-auth tenant directory service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=creator-auth
Group=creator-auth
WorkingDirectory=/opt/creator-auth
EnvironmentFile=/etc/creator-auth/creator-auth.env
ExecStart=/usr/bin/python3 -m creator_auth.server
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

