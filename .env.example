# Network
CREATOR_AUTH_HOST=127.0.0.1
CREATOR_AUTH_PORT=8088
CREATOR_AUTH_PUBLIC_BASE_URL=https://yongshengxingda.com

# Storage
CREATOR_AUTH_DB=/var/lib/creator-auth/creator-auth.db

# Secrets
# Generate with: python3 - <<'PY'
# import secrets; print(secrets.token_urlsafe(48))
# PY
CREATOR_AUTH_SECRET=change-me-generate-a-long-random-secret
CREATOR_AUTH_ADMIN_TOKEN=change-me-admin-token

# WeChat Open Platform website login
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://yongshengxingda.com/auth/wechat/callback

# Desktop login
CREATOR_AUTH_LOGIN_TTL_SECONDS=300
CREATOR_AUTH_SESSION_TTL_SECONDS=2592000
CREATOR_AUTH_GATEWAY_TICKET_TTL_SECONDS=300

# Development only. Keep disabled in production.
CREATOR_AUTH_ALLOW_DEV_LOGIN=0
